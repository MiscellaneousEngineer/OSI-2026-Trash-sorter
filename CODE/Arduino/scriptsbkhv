// Arduino UNO — 5x Ultrasonic sensors → Serial over USB
// Wiring: each sensor has a TRIG and ECHO pin

const int NUM_SENSORS = 5;

// Define TRIG and ECHO pins for each sensor
const int TRIG[NUM_SENSORS] = {2, 4, 6, 8, 10};
const int ECHO[NUM_SENSORS] = {3, 5, 7, 9, 11};

void setup() {
  Serial.begin(115200);
  for (int i = 0; i < NUM_SENSORS; i++) {
    pinMode(TRIG[i], OUTPUT);
    pinMode(ECHO[i], INPUT);
    digitalWrite(TRIG[i], LOW);
  }
}

long readDistance(int trigPin, int echoPin) {
  // Send 10µs pulse
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // Measure echo duration, timeout at 30ms (~5m range)
  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) return -1;  // -1 = no echo / out of range

  // Distance in mm (speed of sound = 343 m/s)
  return duration * 343L / 2000;
}

void loop() {
  for (int i = 0; i < NUM_SENSORS; i++) {
    long dist = readDistance(TRIG[i], ECHO[i]);
    Serial.print(dist);
    if (i < NUM_SENSORS - 1) Serial.print(",");
  }
  Serial.println();  // newline terminates each frame

  delay(100);  // 10Hz
}
